---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | Amber Miro Heinbockel" description="That page does not exist.">
  <section class="hero hero--plain">
    <div class="wrap stack center">
      <p class="eyebrow eyebrow--accent">404</p>
      <h1 class="ds-display h1">That page isn’t here</h1>
      <p class="lede">It may have moved when the site was rebuilt.</p>
      <div class="row"><a class="ds-btn ds-btn--primary" href="/">Go home</a><a class="ds-btn ds-btn--secondary" href="/blog/">Read the blog</a></div>
    </div>
  </section>
</Layout>
